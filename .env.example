APP_NAME="Shofol Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (MySQL recommended for production, SQLite supported)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shofol_connect
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI Service & RAG Configuration
# Primary provider: 'gemini' (default, Google Gemini via OpenAI-compatible endpoint)
# Fallback provider: 'ollama' (automatic retry on 429, 5xx, timeout, or connection failure)
# Supported standalone AI_PROVIDER values: 'gemini', 'ollama', 'openai'
# AI_API_KEY overrides the provider-specific key; otherwise use GEMINI_API_KEY, OLLAMA_API_KEY, or OPENAI_API_KEY.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_TIMEOUT=60
AI_RETRY_TIMES=2
AI_RETRY_DELAY=1000

# Ollama Local LLM Configuration (automatic fallback when Gemini fails, or standalone when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=ollama
AI_FALLBACK_OLLAMA=true
